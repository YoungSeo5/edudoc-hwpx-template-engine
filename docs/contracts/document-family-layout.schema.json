{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "document-family-layout.schema.json",
  "title": "Document Family Layout Recipe v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["family", "recipe_version", "required_components", "component_defaults"],
  "properties": {
    "family": { "const": "one_page_report" },
    "recipe_version": { "const": "v1" },
    "native_page_count": { "type": "integer", "minimum": 1 },
    "required_components": { "type": "array", "items": { "$ref": "#/$defs/component" } },
    "component_defaults": { "type": "object", "additionalProperties": { "type": "object" } }
  },
  "$defs": {
    "component": {
      "enum": ["masthead", "title_block", "header_info", "section", "bullet_list", "key_value_table", "status_table", "callout", "footer_note"]
    }
  }
}
