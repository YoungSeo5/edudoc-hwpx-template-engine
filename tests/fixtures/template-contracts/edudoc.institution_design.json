    "logo_left_width_mm": 26.0,
    "logo_left_height_mm": 14.6,
    "logo_right_asset_id": "test_logo_right",
    "logo_right_width_mm": 14.0,
    "logo_right_height_mm": 14.0,
    "logo_left_slot_width_mm": 34.0,
    "title_slot_width_mm": 102.0,
    "logo_right_slot_width_mm": 34.0
